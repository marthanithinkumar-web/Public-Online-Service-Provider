# Local development config for Vite
VITE_API_URL=http://localhost:5000
# Public canonical origin used by SEO, sitemap and robots generation.
# Production currently uses https://pospindia.onrender.com.
VITE_SITE_URL=http://localhost:5173
# Only legacy/retired frontend builds should set this. When present, visitors are
# moved to the same path/query/hash on the new primary origin.
VITE_LEGACY_REDIRECT_ORIGIN=
