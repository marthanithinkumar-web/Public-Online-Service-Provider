# Copy this file to backend/.env and update values
SECRET_KEY=change-me-to-a-secure-random-string
DATABASE_URL=postgresql://psp:psp_pass@localhost:5432/psp_db
FLASK_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# WhatsApp Business Platform / Meta Cloud API (optional; disabled by default)
WHATSAPP_CLOUD_API_ENABLED=0
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
