# Production environment example - copy to backend/.env and fill values
SECRET_KEY=change-me-to-a-secure-random-string
DATABASE_URL=postgresql://psp:psp_pass@localhost:5432/psp_db
FLASK_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Frontend URL (used in email links)
FRONTEND_URL=https://your-domain.example

# Force HTTPS in Talisman when set to 1
FORCE_HTTPS=1

# SMTP (email)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Public Online Service Provider
SMTP_USE_TLS=1

# Private Cloudflare R2 / S3-compatible storage for request attachments
S3_BUCKET=posp-private-documents
S3_ENDPOINT_URL=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Other
MAX_UPLOAD_MB=10
