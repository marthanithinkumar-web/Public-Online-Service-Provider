# Production environment example - copy to backend/.env and fill values
SECRET_KEY=change-me-to-a-secure-random-string
DATABASE_URL=postgresql://psp:psp_pass@localhost:5432/psp_db
FLASK_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Official frontend URL used in email, push and admin alert links.
FRONTEND_URL=https://pospindia.onrender.com
PUBLIC_APP_URL=https://pospindia.onrender.com
CORS_ORIGINS=https://pospindia.onrender.com

# Force HTTPS in Talisman when set to 1
FORCE_HTTPS=1

# SMTP (email)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Public Online Service Provider
SMTP_USE_TLS=1

# External admin activity alerts. Email uses the SMTP settings above.
# SMS appears in the phone's normal Messages app. WhatsApp uses a WhatsApp-enabled Twilio sender.
# Phone values should use E.164 format, for example +91XXXXXXXXXX.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
ADMIN_WHATSAPP_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Shared rate-limit storage. Use a managed Redis/Valkey URL in production.
# Example: rediss://default:password@host:6379/0
RATELIMIT_STORAGE_URI=

# Private Backblaze B2 / S3-compatible storage for request attachments
S3_BUCKET=posp-private-documents-2026
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-005

# Razorpay production payments. Use the live key pair here (RAZORPAY_KEY_ID
# should start with rzp_live_). Keep KEY_SECRET and WEBHOOK_SECRET server-only.
# Configure the Razorpay dashboard webhook to POST to:
# https://public-online-service-provider-api.onrender.com/api/payments/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# When enabled, /readiness returns HTTP 503 until all launch-critical
# configuration checks pass. Keep 0 while initially configuring services.
STRICT_PRODUCTION_READINESS=0

# Other
MAX_UPLOAD_MB=10
