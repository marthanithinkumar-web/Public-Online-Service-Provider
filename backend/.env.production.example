# Production environment example - copy to backend/.env and fill values
SECRET_KEY=change-me-to-a-secure-random-string
DATABASE_URL=postgresql://psp:psp_pass@localhost:5432/psp_db
FLASK_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Frontend URL (used in email links)
FRONTEND_URL=https://your-domain.example

# Force HTTPS in Talisman when set to 1
FORCE_HTTPS=1

# SMTP (email)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Public Online Service Provider
SMTP_USE_TLS=1

# Administrator email OTP. Enable only after SMTP delivery is confirmed.
ADMIN_2FA_ENABLED=0

# Shared rate-limit storage. Use a managed Redis/Valkey URL in production.
# Example: rediss://default:password@host:6379/0
RATELIMIT_STORAGE_URI=

# Private Backblaze B2 / S3-compatible storage for request attachments
S3_BUCKET=posp-private-documents-2026
S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-005

# Razorpay. Keep KEY_SECRET and WEBHOOK_SECRET on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# When enabled, /readiness returns HTTP 503 until all launch-critical
# configuration checks pass. Keep 0 while initially configuring services.
STRICT_PRODUCTION_READINESS=0

# Other
MAX_UPLOAD_MB=10
