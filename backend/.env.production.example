# Production environment example - copy to backend/.env and fill values
SECRET_KEY=change-me-to-a-secure-random-string
DATABASE_URL=postgresql://psp:psp_pass@localhost:5432/psp_db
FLASK_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
REQUIRE_EMAIL_VERIFICATION=1

# Frontend URL (used in email links)
FRONTEND_URL=https://your-domain.example

# Force HTTPS in Talisman when set to 1
FORCE_HTTPS=1

# SMTP (email)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Public Online Service Provider
SMTP_USE_TLS=1

# S3 for attachments (optional)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Other
MAX_UPLOAD_MB=10
